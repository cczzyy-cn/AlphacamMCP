<Window
	x:Class="小条先切.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="小条先切"
	Height="200"
	Width="525"
	WindowStartupLocation="CenterScreen"
	ResizeMode="NoResize"
	xmlns:小条先切="clr-namespace:小条先切"
	Loaded="Window_Loaded">
	<Grid>
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition
					Height="30" />
				<RowDefinition
					Height="30" />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition
					Height="30" />
			</Grid.RowDefinitions>
			<StackPanel
				Grid.Row="0">
				<Menu
					Height="26">
					<MenuItem
						Header="帮助"
						Height="25">
						<MenuItem
							Name="muRegister"
							Header="注册插件"
							Click="muRegister_Click" />
						<MenuItem
							Name="muUserInfo"
							Header="用户信息"
							Click="muUserInfo_Click" />
						<MenuItem
							Name="muAbout"
							Header="关于插件"
							Click="muAbout_Click" />
					</MenuItem>
				</Menu>
			</StackPanel>
			<TextBlock
				Name="txtblkPrompt"
				Grid.Row="1"
				Height="30"
				TextAlignment="Center" />
			<Grid
				Name="grdSet"
				Row="2">
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="*" />
					<ColumnDefinition
						Width="2*" />
					<ColumnDefinition
						Width="2*" />
					<ColumnDefinition
						Width="3*" />
					<ColumnDefinition
						Width="2*" />
					<ColumnDefinition
						Width="2*" />
					<ColumnDefinition
						Width="2*" />
					<ColumnDefinition
						Width="2*" />
					<ColumnDefinition
						Width="*" />
				</Grid.ColumnDefinitions>
				<TextBlock
					Text="小条范围:"
					Grid.Column="1"
					VerticalAlignment="Center"
					FontSize="16" />
				<TextBox
					Grid.Column="2"
					VerticalAlignment="Center"
					Margin="8"
					FontSize="14"
					Text="{Binding SmallWidth}" />
				<CheckBox
					Name="chkSlooping"
					Grid.Column="3"
					Content="斜线下刀"
					VerticalAlignment="Center"
					Margin="8"
					FontSize="12"
					IsChecked="{Binding IsSloopingLine}"
					Click="CheckBox_Click" />
				<TextBlock
					Text="斜线距离:"
					Grid.Column="4"
					VerticalAlignment="Center"
					Margin="5"
					HorizontalAlignment="Right"
					FontSize="12" />
				<TextBox
					Name="txtSloopDist"
					Grid.Column="5"
					VerticalAlignment="Center"
					Margin="8"
					FontSize="14"
					Text="{Binding SloopDist}" />
				<TextBlock
					Text="后退距离:"
					Grid.Column="6"
					VerticalAlignment="Center"
					Margin="5"
					HorizontalAlignment="Right"
					FontSize="12" />
				<TextBox
					Name="txtBackDist"
					Grid.Column="7"
					VerticalAlignment="Center"
					Margin="8"
					FontSize="14"
					Text="{Binding BackDist}" />
			</Grid>
			<Grid
				Name="grdToolName"
				Row="3">
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="1.15*" />
					<ColumnDefinition
						Width="3*" />
					<ColumnDefinition
						Width="*" />
					<ColumnDefinition
						Width="0.4*" />
				</Grid.ColumnDefinitions>
				<TextBlock
					Text="刀具名称:"
					Grid.Column="0"
					Height="25"
					FontSize="16"
					VerticalAlignment="Top"
					TextAlignment="Right"
					Margin="10,0" />
				<ComboBox
					Name="cmbToolName"
					Grid.Column="1"
					Height="24"
					Margin="5,0"
					VerticalAlignment="Top"
					SelectedItem="{Binding ToolName}"
					SelectionChanged="cmbToolName_SelectionChanged" />
				<CheckBox
					Name="chbUniCutTool"
					Grid.Column="2"
					Content="合并切断刀"
					Margin="5,0"
					Height="30"
					IsChecked="{Binding IsUniqueCutTool}" />
			</Grid>
			<Grid
				Row="4">
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="*" />
					<ColumnDefinition
						Width="2*" />
					<ColumnDefinition
						Width="2*" />
					<ColumnDefinition
						Width="*" />
				</Grid.ColumnDefinitions>
				<Button
					Name="btnOK"
					Content="优化"
					Grid.Column="1"
					Margin="2"
					Width="80"
					Click="btnOK_Click" />
				<Button
					Name="btnCancel"
					Content="取消"
					Grid.Column="2"
					Margin="2"
					Width="80"
					Click="btnCancel_Click" />
			</Grid>
		</Grid>
	</Grid>
</Window>
