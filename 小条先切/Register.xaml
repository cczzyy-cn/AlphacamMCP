<Window
	x:Class="小条先切.Register"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="用户注册"
	Height="200"
	Width="300"
	ResizeMode="NoResize"
	WindowStartupLocation="CenterScreen"
	xmlns:小条先切="clr-namespace:小条先切">
	<Grid>
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition
					Height="30" />
				<RowDefinition />
				<RowDefinition
					Height="30" />
			</Grid.RowDefinitions>
			<TextBlock
				Text="注册码"
				FontSize="16"
				TextAlignment="Center"
				VerticalAlignment="Center" />
			<TextBox
				Name="txtHardInfo"
				Grid.Row="1"
				Margin="5"
				TextWrapping="Wrap" />
			<Grid
				Row="2">
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="*" />
					<ColumnDefinition
						Width="2*" />
					<ColumnDefinition
						Width="2*" />
					<ColumnDefinition
						Width="*" />
				</Grid.ColumnDefinitions>
				<Button
					Content="注册"
					Grid.Column="1"
					Margin="5"
					Width="60"
					Click="Button_Click_1" />
				<Button
					Content="取消"
					Grid.Column="2"
					Margin="5"
					Width="60"
					Click="Button_Click" />
			</Grid>
		</Grid>
	</Grid>
</Window>
